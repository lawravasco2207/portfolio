# The deployed public origin. Set this at BUILD time for share metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: no credentials are needed to browse the portfolio or engineering study.
# Admin stays disabled until both values are configured.
ADMIN_PASSWORD=
# Generate a random secret of at least 32 characters. Never use the password here.
ADMIN_SESSION_SECRET=

# Optional contact delivery. Empty configuration shows a helpful error, not a false success.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# Optional content persistence. Without Spaces, projects come from data/projects.json.
DO_SPACES_ENDPOINT=
DO_SPACES_REGION=
DO_SPACES_BUCKET=
DO_SPACES_KEY=
DO_SPACES_SECRET=

# Optional server-only token for GitHub API rate limits. Use public-read access only.
GITHUB_TOKEN=
